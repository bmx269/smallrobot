# Copy to .env (gitignored) and fill in. CI supplies these as repository secrets.
# apiBase is the Drupal JSON:API prefix; fileBase is the bare host files hang off
# (file uris are host-relative, /sites/default/files/..., so they must not get the
# API prefix).
NUXT_PUBLIC_API_BASE=https://cms.example.com/api
NUXT_PUBLIC_FILE_BASE=https://cms.example.com
